# ==============================================================================
# FLANGE CRAFT — ENVIRONMENT VARIABLE TEMPLATE (NAMES ONLY — NO SECRET VALUES)
# ==============================================================================

# --- Frontend (Vercel / Vite Build) ---
# Base URL of the deployed persistent Node.js backend API (e.g. on Render / Railway).
# Leave empty in local development to use the Vite dev server proxy (/api -> localhost:3001).
VITE_API_BASE_URL=

# --- Backend Server & Persistent Storage (Render / Railway / Node Host) ---
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=1

# Absolute path to the SQLite database file on a mounted persistent disk volume
# Example on Render/Railway persistent disk: /var/data/flange_craft.db
DATABASE_PATH=

# Comma-separated list of allowed frontend origins for CORS (e.g. your Vercel production URL)
ALLOWED_ORIGINS=
FRONTEND_URL=

# --- Initial Administrator Provisioning ---
# Used only to provision the initial admin account when no admin user exists in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Razorpay Payment Gateway (Currently Unconfigured / Disabled by Default) ---
# Leave empty while Razorpay merchant onboarding is not active.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional Email Provider for Password Reset (Optional) ---
RESEND_API_KEY=
EMAIL_FROM=
